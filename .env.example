# Server only. Never commit .env.local or paste credentials in chat.
APP_MODE=demo
APP_URL=http://127.0.0.1:3000
# Production never permits demo mode. Local demo uses an isolated database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
AUTH_SECRET=REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL_LOGIN=
TWITCH_BROADCASTER_ID=
TWITCH_EMBED_PARENTS=localhost,127.0.0.1
STREAMELEMENTS_JWT=
STREAMELEMENTS_CHANNEL_ID=
EVENTSUB_SECRET=
JOB_SECRET=
# Optional Vercel Cron authentication; use an independent random secret (32+ characters).
CRON_SECRET=
ADMIN_TWITCH_USER_IDS=
# These values may be projected into the public site config.
DISCORD_INVITE_URL=
POINTS_NAME=Vault Points
POINTS_SYMBOL=VP
# Versioned DB rule is authoritative; these are first-install defaults only.
POINTS_PER_INTERVAL=10
POINTS_INTERVAL_SECONDS=600
HISTORICAL_IMPORT=off
